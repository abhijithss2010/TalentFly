{
  "name": "@talentfly/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "generate:build-info": "node scripts/generate-build-info.mjs",
    "dev": "npm run generate:build-info && tsx watch src/main.ts",
    "build": "npm run generate:build-info && tsc -p tsconfig.build.json",
    "typecheck": "npm run generate:build-info && tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src",
    "test": "npm run generate:build-info && vitest run --config vitest.config.mts"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
